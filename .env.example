# Clerk routes
VITE_CLERK_SIGN_IN_URL=
VITE_CLERK_SIGN_UP_URL=
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=

# Clerk credentials
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex application connection
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Cloudflare R2 credentials
# CLOUDFLARE_TOKEN_VALUE is for Cloudflare management operations. The
# application uses the S3-compatible access key and secret for object access.
CLOUDFLARE_TOKEN_VALUE=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=

# Cloudflare R2 endpoints and bucket
CLOUDFLARE_R2_DEFAULT_ENDPOINT=
CLOUDFLARE_R2_EUROPE_ENDPOINT=
CLOUDFLARE_R2_BUCKET_NAME=

# Internal file lifecycle boundary shared with Convex
# Generate with: openssl rand -hex 32
# Set the identical value in the Convex deployment; see .env.example.convex.
FILE_SERVICE_SECRET=

# Canonical same-origin allowed to call the private files REST API.
# Production values must use HTTPS, for example: https://app.example.com
FILE_API_ORIGIN=
