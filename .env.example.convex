# Clerk JWT issuer used by convex/auth.config.ts.
CLERK_JWT_ISSUER_DOMAIN=

# Internal file lifecycle boundary
# Must exactly match FILE_SERVICE_SECRET in the application environment.
# Configure with:
# bunx convex env set FILE_SERVICE_SECRET '<generated-value>'
FILE_SERVICE_SECRET=

# Absolute deployed application endpoint invoked by the scheduled cleanup.
# Example: https://example.com/api/files/cleanup
FILE_CLEANUP_URL=
