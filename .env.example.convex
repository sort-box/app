# Clerk JWT issuer used by convex/auth.config.ts.
CLERK_JWT_ISSUER_DOMAIN=

# Internal file lifecycle boundary
# Must exactly match FILE_SERVICE_SECRET in the application environment.
# Configure with:
# bunx convex env set FILE_SERVICE_SECRET '<generated-value>'
FILE_SERVICE_SECRET=

# Absolute deployed application endpoint invoked by the scheduled cleanup.
# Example: https://example.com/api/files/cleanup
FILE_CLEANUP_URL=

# R2 access used by Convex document embedding workers.
# Use the same values as the application environment.
CLOUDFLARE_R2_EUROPE_ENDPOINT=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=

# Voyage document embedding key used by Convex ingestion actions.
# Configure with: bunx convex env set VOYAGE_API_KEY '<api-key>'
VOYAGE_API_KEY=
